---
import BenchmarkDashboard from './BenchmarkDashboard';
import '../../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#09090d" />
    <meta name="description" content="Explore a recorded playground experiment and illustrative Harness² benchmark visualizations." />
    <title>Harness² Benchmark — Agent Optimization Analysis</title>
    <link rel="stylesheet" href="https://alexisalulema.com/demo-theme.css" />
    <script is:inline>
      window.DEMO_INFO = {
        title: "Harness² Benchmark Analysis",
        titleEs: "Análisis de benchmarks Harness²",
        overview: "Explore a recorded educational playground experiment and a separate illustrative benchmark dashboard. The playground is inspired by Harness²; it is not Google's official framework.",
        overviewEs: "Explora un experimento educativo registrado en playground y un dashboard ilustrativo separado. Playground está inspirado en Harness², pero no es el framework oficial de Google.",
        architecture: {
          description: "A pinned playground study is normalized into static data. A separate parser accepts normalized benchmark summaries, not native Harness² artifacts. Astro serves both views without a database or model API.",
          descriptionEs: "Un estudio fijado de playground se normaliza en datos estáticos. Un parser separado acepta resúmenes normalizados, no artefactos nativos de Harness². Astro sirve ambas vistas sin base de datos ni API de modelos.",
          diagram: `flowchart LR
  RUNS["Normalized benchmark summaries"] --> PARSER["Python parser<br/>Pydantic + Pandas"]
  STUDY["Pinned playground records"] --> IMPORT["Study adapter"]
  IMPORT --> UI
  PARSER --> JSON["Static JSON + CSV"]
  JSON --> UI["Astro + React dashboard"]
  UI --> CHARTS["Filters · charts · exports"]
  GHCR["Public GHCR image"] --> ACA["Ephemeral Container Apps"]
  ACA --> UI`
        },
        infra: [
          { name: "Astro + React", role: "Static dashboard UI with interactive filtering and visualizations.", roleEs: "Interfaz estática con filtros interactivos y visualizaciones." },
          { name: "Python parser", role: "Validates run summaries and emits JSON and CSV artifacts.", roleEs: "Valida resúmenes de ejecución y genera artefactos JSON y CSV." },
          { name: "Nginx", role: "Serves the static site on internal ingress at port 8080.", roleEs: "Sirve el sitio estático en ingress interno, puerto 8080." },
          { name: "GHCR", role: "Public container image consumed by the ephemeral demo infrastructure.", roleEs: "Imagen pública de contenedor consumida por la infraestructura efímera." }
        ],
        sizing: "One stateless container serving precomputed static data. No external service, runtime secret, or persistent storage is required.",
        sizingEs: "Un contenedor sin estado sirve datos estáticos precalculados. No requiere servicios externos, secretos en runtime ni almacenamiento persistente.",
        design: [
          "Run data is validated and generated before the frontend build; dashboard requests never invoke an LLM.",
          "Measured data replaces the bundled illustrative preview when parser output is generated.",
          "CSV export works for the full dataset and for the currently filtered run table."
        ],
        designEs: [
          "Los datos se validan y generan antes del build; el dashboard no invoca modelos de lenguaje.",
          "Los resultados medidos reemplazan los datos ilustrativos incluidos cuando se ejecuta el parser.",
          "La exportación CSV admite el conjunto completo y la tabla filtrada actual."
        ],
        limitations: [
          "The playground study is exploratory and qualitative human review is pending.",
          "The separate benchmark preview uses illustrative values; its parser does not accept native Harness² artifact trees.",
          "The demo is read-only and does not execute the Harness² optimizer."
        ],
        limitationsEs: [
          "El estudio de playground es exploratorio y la revisión cualitativa humana está pendiente.",
          "La vista de benchmark es ilustrativa; su parser no acepta árboles de artefactos nativos de Harness².",
          "La demo es de solo lectura y no ejecuta el optimizador Harness²."
        ],
        links: { repo: "https://github.com/alulema/harness-benchmark" },
        lang: "auto"
      };
    </script>
    <script is:inline src="https://alexisalulema.com/demo-panel.js" defer></script>
  </head>
  <body>
    <BenchmarkDashboard client:load />
  </body>
</html>
